{
  "testEnvironment": "node",
  "setupFilesAfterEnv": ["./tests/setup.js"],
  "transform": {},
  "roots": ["<rootDir>/tests"],
  "testMatch": [
    "**/*.test.js",
    "**/*.spec.js"
  ],
  "collectCoverage": false,
  "collectCoverageFrom": [
    "controllers/**/*.js",
    "middleware/**/*.js",
    "routes/**/*.js",
    "utils/**/*.js",
    "server.js",
    "!**/*.test.js",
    "!**/*.spec.js"
  ],
  "coverageDirectory": "coverage",
  "coverageReporters": ["text", "lcov", "html", "json"],
  "coverageThreshold": {
    "global": {
      "branches": 80,
      "functions": 80,
      "lines": 80,
      "statements": 80
    }
  },
  "testTimeout": 30000,
  "verbose": true,
  "forceExit": true,
  "detectOpenHandles": true,
  "modulePathIgnorePatterns": ["<rootDir>/node_modules/"],
  "testPathIgnorePatterns": ["/node_modules/", "/coverage/"],
  "globals": {
    "__DEV__": true
  }
}
