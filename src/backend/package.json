{
  "name": "vibe-coding-accelerator-backend",
  "version": "1.0.0",
  "description": "Backend API for Vibe Coding Accelerator - LLM standards enforcer with project management",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --detectOpenHandles",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage --detectOpenHandles",
    "test:ci": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage --ci --watchAll=false --detectOpenHandles",
    "lint": "eslint . --ext .js --fix",
    "lint:check": "eslint . --ext .js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "security:audit": "npm audit",
    "security:fix": "npm audit fix",
    "precommit": "npm run lint:check && npm run format:check && npm run test:ci",
    "quality": "npm run lint:check && npm run format:check && npm run security:audit"
  },
  "keywords": [
    "nodejs",
    "express",
    "api",
    "llm",
    "ai",
    "code-standards",
    "project-management"
  ],
  "author": "Vibe Coding Accelerator Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "fs-extra": "^11.2.0",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "path": "^0.12.7",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@jest/globals": "^30.0.5",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jest": "^28.6.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-security": "^3.0.1",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.3.3",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
